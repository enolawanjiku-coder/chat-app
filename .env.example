VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173
# YouTube Data API v3 key (browser key, restrict by HTTP referrer). Enables music search.
VITE_YOUTUBE_API_KEY=
# Optional TURN relay for screen sharing when direct peer-to-peer fails (symmetric NAT / strict firewalls).
# STUN works for most users; add these only if some pairs can't connect. Neither media nor creds touch Supabase.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Web Push (background notifications). Public VAPID key only (safe to expose).
# Generate a pair with: npx web-push generate-vapid-keys
# The private key goes in the `send-push` Edge Function secret, never here.
VITE_VAPID_PUBLIC_KEY=
